{
  "name": "kanon",
  "version": "2.0.0-dev",
  "description": "Local-first knowledge indexes. Repos are sources; QMD is the search engine; never-rest is the contract.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "kanon": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "kanon": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "docs:index": "tsx scripts/docs-index.ts --update",
    "docs:search": "tsx scripts/docs-index.ts --search",
    "docs:get": "tsx scripts/docs-index.ts --get"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@eddy-works/never-rest": "file:../never-rest",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tobilu/qmd": "2.8.3",
    "neverthrow": "^8.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
